{
  "name": "@mbelinky/openclaw-claude-sessions",
  "version": "0.1.0-beta.1",
  "description": "Ask existing Claude Code sessions through OpenClaw agents on any channel",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "index.mjs",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbelinky/claude-code-socket-transport.git",
    "directory": "openclaw-plugin"
  },
  "scripts": {
    "test": "node --test tests/plugin.test.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.8"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.9.8",
      "minGatewayVersion": "2026.9.8"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
